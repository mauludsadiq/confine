  let c = cfg() in
  let s0 = state_mod.initial(c) in
  let d = create_draft(s0, "cust_001", "inv_001", "thread_001", "nonce-test-0014", labels.customer_label("cust_001"), "drafter_1") in
  let a = engine.apply_with_receipt(d.state, {
    t: "approve_draft",
    draft_hash: d.result.draft_hash,
    approver_id: "approver_1",
    nonce: "nonce-test-0015",
    expected_state_hash: state_mod.hash_state(d.state)
  }, "approver_1", c.capabilities, c.policy, c.broker_secret) in
  let s = engine.apply_with_receipt(a.state, {
    t: "submit_draft",
    draft_hash: d.result.draft_hash,
    recipient: "billing@example.test",
    recipient_label: labels.customer_label("cust_001"),
    nonce: "nonce-test-0016",
    expected_state_hash: state_mod.hash_state(a.state)
  }, "approver_1", c.capabilities, c.policy, c.broker_secret) in

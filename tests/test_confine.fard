import("std/rec") as rec
import("../packages/confine/config") as config_mod
import("../packages/confine/state") as state_mod
import("../packages/confine/engine") as engine
import("../packages/confine/labels") as labels
import("../packages/confine/receipts") as receipts
import("../examples/invoice_config") as invoice_config
import("../packages/confine/certificate") as certificate_mod
import("../packages/confine/executor") as executor
import("../packages/confine/policy") as policy_mod
import("../packages/confine/commit_store") as commit_store
import("../packages/confine/canonical") as canonical

fn cfg() { invoice_config.build("0123456789abcdef0123456789abcdef") }

fn create_draft(state, customer_id, invoice_id, thread_id, nonce, body_label, actor_id) {
  let c = cfg() in
  engine.apply_with_receipt(state, {
    t: "create_draft",
    thread_id: thread_id,
    invoice_id: invoice_id,
    customer_id: customer_id,
    body: "Please review the outstanding invoice.",
    body_label: body_label,
    nonce: nonce,
    expected_state_hash: state_mod.hash_state(state)
  }, actor_id, c.capabilities, c.policy, c.broker_secret)
}

test "configuration validates" {
  config_mod.validate(cfg()).t == "ok"
}

test "genuine transition commits and receipt verifies" {
  let c = cfg() in
  let s = state_mod.initial(c) in
  let r = create_draft(s, "cust_001", "inv_001", "thread_001", "nonce-test-0001", labels.customer_label("cust_001"), "drafter_1") in
  r.t == "committed" && receipts.verify(r.receipt).t == "ok"
}

test "unknown action is rejected at parse boundary" {
  let c = cfg() in
  let s = state_mod.initial(c) in
  let r = engine.apply_with_receipt(s, { t: "shell", command: "whoami" }, "drafter_1", c.capabilities, c.policy, c.broker_secret) in
  r.t == "rejected" && r.stage == "parse"
}

test "unknown fields are rejected" {
  let c = cfg() in
  let s = state_mod.initial(c) in
  let r = engine.apply_with_receipt(s, {
    t: "read_invoice",
    invoice_id: "inv_001",
    nonce: "nonce-test-0002",
    expected_state_hash: state_mod.hash_state(s),
    command: "hidden"
  }, "drafter_1", c.capabilities, c.policy, c.broker_secret) in
  r.t == "rejected" && r.stage == "parse"
}

test "customer data cannot flow to another customer label" {
  let c = cfg() in
  let s = state_mod.initial(c) in
  let r = create_draft(s, "cust_001", "inv_001", "thread_001", "nonce-test-0003", labels.customer_label("cust_002"), "drafter_1") in
  r.t == "rejected" && r.stage == "policy" && r.error.code == "IFC_INVOICE_TO_BODY"
}

test "capability denial blocks approver operation by drafter" {
  let c = cfg() in
  let s0 = state_mod.initial(c) in
  let d = create_draft(s0, "cust_001", "inv_001", "thread_001", "nonce-test-0004", labels.customer_label("cust_001"), "drafter_1") in
  let r = engine.apply_with_receipt(d.state, {
    t: "approve_draft",
    draft_hash: d.result.draft_hash,
    approver_id: "drafter_1",
    nonce: "nonce-test-0005",
    expected_state_hash: state_mod.hash_state(d.state)
  }, "drafter_1", c.capabilities, c.policy, c.broker_secret) in
  r.t == "rejected" && r.error.code == "CAPABILITY_DENIED"
}

